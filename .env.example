NODE_ENV=development
PORT=8001
APP_BASE_URL=http://goblog-nawanu.local
DB_HOST=dev-mysql
DB_USER=root
DB_PASS=mysqlDbPass2026
DB_NAME=goblog_nawanu
REDIS_URL=redis://dev-redis:6379
JWT_SECRET=change-me-to-a-real-secret
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=10000
USE_JOB_QUEUE=true
SCHEDULER_QUEUE_CONCURRENCY=3

# WhatsApp ban prevention
WA_RATE_LIMIT_PER_MINUTE=10
WA_DAILY_LIMIT_PER_DEVICE=200
WA_RECONNECT_BASE_DELAY=30000
WA_MAX_RETRIES=5
GLOBAL_RATE_LIMIT_PER_MINUTE=60
SCHEDULER_DEVICE_CONCURRENCY=2
SCHEDULER_RATE_MIN_MS=2000
SCHEDULER_RATE_MAX_MS=7000
SCHEDULER_MAX_RETRIES=3
SCHEDULER_BASE_BACKOFF_SECONDS=60